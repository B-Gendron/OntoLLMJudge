<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#"
     xml:base="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:expertassessmentschema="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#">
    <owl:Ontology rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema">
        <terms:license rdf:resource="https://creativecommons.org/licenses/by/4.0"/>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.org/dc/terms/license -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/license"/>
    


    <!-- http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#example -->

    <owl:AnnotationProperty rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#example"/>
    


    <!-- http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#extractionDate -->

    <owl:AnnotationProperty rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#extractionDate">
        <rdfs:label>extractionDate</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#extractionMethod -->

    <owl:AnnotationProperty rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#extractionMethod">
        <rdfs:comment>Records whether a hasRelevantElement assertion was derived by direct text match (&apos;exact&apos;, &apos;fuzzy&apos;, &apos;syntactic&apos;) or by SKOS implication expansion (&apos;implied&apos;).</rdfs:comment>
        <rdfs:label>extractionMethod</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#containsQualityDimension -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#containsQualityDimension">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#isPartOf"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#ExpertAssessmentSchema"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#QualityDimension"/>
        <rdfs:comment>The property connect an assessment schema to the quality dimensionsit assesses.</rdfs:comment>
        <rdfs:label>contains quality dimension</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#explainsMistake -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#explainsMistake">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#isExplainedBy"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#Explanation"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#OPRMistake"/>
        <rdfs:comment>The property connect an explanaition to the encountered mistake it explains.</rdfs:comment>
        <rdfs:label>explains mistake</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasQualityDimensionInstance -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasQualityDimensionInstance">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#isQualityDimensionOf"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#Explanation"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#QualityDimension"/>
        <rdfs:comment>The property connect an explanation to the quality dimensions that describes it.</rdfs:comment>
        <rdfs:label>has quality dimension</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasRelevantElement -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasRelevantElement">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#isRelevantElementOf"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#OPRMistake"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#OPRModelingRelevantElement"/>
        <rdfs:comment>The property connect a mistake to relevant ontological elements that have lead to the mistake or are affected by it.</rdfs:comment>
        <rdfs:label>has relevant element</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasScoringLevel -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasScoringLevel">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#isScoringLevelOf"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#QualityDimension"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#ScoringLevel"/>
        <rdfs:comment>The property connect a quality dimension to its scoring level</rdfs:comment>
        <rdfs:label>has scoring level</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasUnintendedOutcome -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasUnintendedOutcome">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#isAnUnintendedOutcomeOf"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#OPRMistake"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#OPRMistakeUnintendedOutcome"/>
        <rdfs:comment>The property connect a mistake to the unintened consequences it causes.</rdfs:comment>
        <rdfs:label>has unintended outcome</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#isAnUnintendedOutcomeOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#isAnUnintendedOutcomeOf">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#OPRMistakeUnintendedOutcome"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#OPRMistake"/>
        <rdfs:comment>The property connects an unintended consequence to the mistakes that cause it.</rdfs:comment>
        <rdfs:label>is an unintened outcome of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#isExplainedBy -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#isExplainedBy">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#OPRMistake"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#Explanation"/>
        <rdfs:comment>The property connect a mistake to its explanation.</rdfs:comment>
        <rdfs:label>is explained by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#isPartOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#isPartOf">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#QualityDimension"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#ExpertAssessmentSchema"/>
        <rdfs:comment>The property connect a quality dimension to the assesment schema it is part of.</rdfs:comment>
        <rdfs:label>is part of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#isQualityDimensionOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#isQualityDimensionOf">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#QualityDimension"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#Explanation"/>
        <rdfs:comment>The property connect a quality dimensions to an explanation it assesses.</rdfs:comment>
        <rdfs:label>is quality dimension of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#isRelevantElementOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#isRelevantElementOf">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#OPRModelingRelevantElement"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#OPRMistake"/>
        <rdfs:comment>The property connects ontological elements to a mistake they are relvant for</rdfs:comment>
        <rdfs:label>is relevant element for</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#isScoringLevelOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#isScoringLevelOf">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#ScoringLevel"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#QualityDimension"/>
        <rdfs:comment>The property connect an a scoring level to the quality dimension it describes</rdfs:comment>
        <rdfs:label>is scoring level of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasText -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasText">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#Explanation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>the property connects an explanation instance to its textual content</rdfs:comment>
        <rdfs:label>has text</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#AbsenceOfInferenceCapability -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#AbsenceOfInferenceCapability">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#InferenceCapability"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#InferenceCapability"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasScoringLevel"/>
                        <owl:hasValue rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#void"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment>The explanation does not point out to (potential) unintended outcomes of the mistake.</rdfs:comment>
        <rdfs:label>Absence of Inference Capability</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#AbsenceOfMistakeCorrectionCompetence -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#AbsenceOfMistakeCorrectionCompetence">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#MistakeCorrectionCompetence"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#MistakeCorrectionCompetence"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasScoringLevel"/>
                        <owl:hasValue rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#void"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment>The explanation does not include a modeling suggestion for fixing the mistake.</rdfs:comment>
        <rdfs:label>Absence of Mistake Correction Competence</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#AbsenceOfModelingComprehension -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#AbsenceOfModelingComprehension">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#ModelingComprehension"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#ModelingComprehension"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasScoringLevel"/>
                        <owl:hasValue rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#void"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment>The explanation does not contains an interpretation of the modeling.</rdfs:comment>
        <rdfs:label>Absence of Modeling Comprehension</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#AppropriateVocabularyUsage -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#AppropriateVocabularyUsage">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#QualityDimension"/>
        <rdfs:comment>Quality dimension centered around the correctness of the vocabulary used within the expalnation.</rdfs:comment>
        <rdfs:label>Appropriate Vocabulary Usage</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#CompleteInferenceCapability -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#CompleteInferenceCapability">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#InferenceCapability"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#InferenceCapability"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasScoringLevel"/>
                        <owl:hasValue rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#correct"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment>The explanation correctly and completely points out to (potential) unintended outcomes of the mistake.</rdfs:comment>
        <rdfs:label>Complete Inference Capability</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#CorrectMistakeCorrectionCompetence -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#CorrectMistakeCorrectionCompetence">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#MistakeCorrectionCompetence"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#MistakeCorrectionCompetence"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasScoringLevel"/>
                        <owl:hasValue rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#correct"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment>The explanation includes a correct modeling suggestion for fixing the mistake.</rdfs:comment>
        <rdfs:label>Correct Mistake Correction Competence</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#CorrectModelingComprehension -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#CorrectModelingComprehension">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#ModelingComprehension"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#ModelingComprehension"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasScoringLevel"/>
                        <owl:hasValue rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#correct"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment>The explanation contains a correct interpretation of the modeling of all relevant elements.</rdfs:comment>
        <rdfs:label>Correct Modeling Comprehension</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#CorrectVocabularyUsage -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#CorrectVocabularyUsage">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#AppropriateVocabularyUsage"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#AppropriateVocabularyUsage"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasScoringLevel"/>
                        <owl:hasValue rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#correct"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment>The explanation demonstrates correct usage of domain-specific (ontology) terminology.</rdfs:comment>
        <rdfs:label>Correct Vocabulary Usage</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#ExpertAssessmentSchema -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#ExpertAssessmentSchema">
        <rdfs:comment>The Expert-Assessment Schema used to evaluate ontology axiom mistake explanations according to four key dimension: Modeling Comprehension, Inference Capability, Mistake Correction Competence and Appropriate Vocabulary Usage. For each dimension, the generated content matches one of the possible statements, and each statement gives a certain score.</rdfs:comment>
        <rdfs:label>Expert Assesment Schema</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#Explanation -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#Explanation">
        <rdfs:comment>An explantion explains the occurance of a concrete mistake</rdfs:comment>
        <rdfs:label>Mistake Explanation</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#IncorrectInferenceCapability -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#IncorrectInferenceCapability">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#InferenceCapability"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#InferenceCapability"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasScoringLevel"/>
                        <owl:hasValue rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#wrong"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment>The explanation incorrectly points out to (potential) unintended outcomes of the mistake.</rdfs:comment>
        <rdfs:label>Inocrrect Inference Capability</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#IncorrectMistakeCorrectionCompetence -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#IncorrectMistakeCorrectionCompetence">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#MistakeCorrectionCompetence"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#MistakeCorrectionCompetence"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasScoringLevel"/>
                        <owl:hasValue rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#wrong"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment>The explanation includes an incorrect modeling suggestion for fixing the mistake.</rdfs:comment>
        <rdfs:label>Incorrect Mistake Correction Competence</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#IncorrectModelingComprehension -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#IncorrectModelingComprehension">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#ModelingComprehension"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#ModelingComprehension"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasScoringLevel"/>
                        <owl:hasValue rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#wrong"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment>The explanation contains an incorrect interpretation of the modeling.</rdfs:comment>
        <rdfs:label>Incorrect Modeling Comprehension</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#IncorrectVocabularyUsage -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#IncorrectVocabularyUsage">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#AppropriateVocabularyUsage"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#AppropriateVocabularyUsage"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasScoringLevel"/>
                        <owl:hasValue rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#wrong"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment>The explanation demonstrates incorrect usage of domain-specific (ontology) terminology.</rdfs:comment>
        <rdfs:label>Inorrect Vocabulary Usage</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#InferenceCapability -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#InferenceCapability">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#QualityDimension"/>
        <rdfs:comment>Quality dimension centered around the corrctenss of inferences made and explained within the expalnation.</rdfs:comment>
        <rdfs:label>Inference Capability</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#MistakeCorrectionCompetence -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#MistakeCorrectionCompetence">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#QualityDimension"/>
        <rdfs:comment>Quality dimension centered around the correctness of mistake corrections proposed within the expalnation.</rdfs:comment>
        <rdfs:label>Mistake Correction Competence</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#ModelingComprehension -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#ModelingComprehension">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#QualityDimension"/>
        <rdfs:comment>Quality dimension centered around the correctness of the interpretation of the incorect model</rdfs:comment>
        <rdfs:label>Modeling Comprehension</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#OPRMistake -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#OPRMistake">
        <rdfs:comment>An Ontology Property Restriction (OPR) mistake is a modeling error made by a student when they write ontology property restrictions.</rdfs:comment>
        <rdfs:label>Ontology Property Restriction Mistake</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#OPRMistakeType1DomainRangeInconsistency -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#OPRMistakeType1DomainRangeInconsistency">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#OPRMistake"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#OPRMistake"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasRelevantElement"/>
                        <owl:hasValue rdf:resource="http://www.semanticweb.org/user/vocabularies/owl2-opr#re_domain"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasRelevantElement"/>
                        <owl:hasValue rdf:resource="http://www.semanticweb.org/user/vocabularies/owl2-opr#re_individual"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasRelevantElement"/>
                        <owl:hasValue rdf:resource="http://www.semanticweb.org/user/vocabularies/owl2-opr#re_object_property"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasRelevantElement"/>
                        <owl:hasValue rdf:resource="http://www.semanticweb.org/user/vocabularies/owl2-opr#re_range"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasRelevantElement"/>
                        <owl:hasValue rdf:resource="http://www.semanticweb.org/user/vocabularies/owl2-opr#re_restriction"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasUnintendedOutcome"/>
                        <owl:hasValue rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#uo_inconsistency"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasRelevantElement"/>
                        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">5</owl:qualifiedCardinality>
                        <owl:onClass rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#OPRModelingRelevantElement"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasUnintendedOutcome"/>
                        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                        <owl:onClass rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#OPRMistakeUnintendedOutcome"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <example>Assuming the object property takesPictureOf is defined with a domain Photographer and range Wedding. To model the intention “A Photographer takes pictures of at least 10 Guests” one might add a restriction “Photographer takesPictureOf min 10 Guest”. However, such a restriction could lead to an inconsistency or wrong inferences such as Guest being a sucClassOf Wedding.</example>
        <rdfs:comment>Mismatch between the domain and range of an object property and the property restriction definition. Students often overlook the domain and range of object properties and thus define restrictions which do not comply with existing ontology definition.</rdfs:comment>
        <rdfs:label>OPR Mistake Type 1: Domain/Range Inconsistency</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#OPRMistakeType2DomainRangeMisplacement -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#OPRMistakeType2DomainRangeMisplacement">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#OPRMistake"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#OPRMistake"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasRelevantElement"/>
                        <owl:hasValue rdf:resource="http://www.semanticweb.org/user/vocabularies/owl2-opr#re_individual"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasRelevantElement"/>
                        <owl:hasValue rdf:resource="http://www.semanticweb.org/user/vocabularies/owl2-opr#re_object_property"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasRelevantElement"/>
                        <owl:hasValue rdf:resource="http://www.semanticweb.org/user/vocabularies/owl2-opr#re_range"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasRelevantElement"/>
                        <owl:hasValue rdf:resource="http://www.semanticweb.org/user/vocabularies/owl2-opr#re_restriction"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasUnintendedOutcome"/>
                        <owl:hasValue rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#uo_inconsistency"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasRelevantElement"/>
                        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">4</owl:qualifiedCardinality>
                        <owl:onClass rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#OPRModelingRelevantElement"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasUnintendedOutcome"/>
                        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                        <owl:onClass rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#OPRMistakeUnintendedOutcome"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <example>To model the intention “A Student attends at least 3 Courses” one might add a property restriction as the range of the object property attends such as “attends min 3 Course”. However, this placement would result in the definition that the range of attends must be a Thing that attends 3 Courses rather than the intended meaning.</example>
        <rdfs:comment>Incorrect property restriction placement in the property range. Often novice knowledge engineers define the restriction in the range of the object property rather than at the class-level, which changes its logical interpretation and often leads to inconsistencies.</rdfs:comment>
        <rdfs:label>OPR Mistake Type 2: Restriction Misplacement at the Property Domain/Range</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#OPRMistakeType3EquivalenceMisuse -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#OPRMistakeType3EquivalenceMisuse">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#OPRMistake"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#OPRMistake"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasRelevantElement"/>
                        <owl:hasValue rdf:resource="http://www.semanticweb.org/user/vocabularies/owl2-opr#re_restriction"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasRelevantElement"/>
                        <owl:hasValue rdf:resource="http://www.semanticweb.org/user/vocabularies/owl2-opr#re_sub_class_of_axiom"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasRelevantElement"/>
                        <owl:hasValue rdf:resource="http://www.semanticweb.org/user/vocabularies/owl2-opr#re_subclass"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasRelevantElement"/>
                        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">3</owl:qualifiedCardinality>
                        <owl:onClass rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#OPRModelingRelevantElement"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#OPRMistake"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasUnintendedOutcome"/>
                        <owl:hasValue rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#uo_over_restriction"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasUnintendedOutcome"/>
                        <owl:hasValue rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#uo_wrong_class_restricted"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasUnintendedOutcome"/>
                        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</owl:qualifiedCardinality>
                        <owl:onClass rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#OPRMistakeUnintendedOutcome"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <example>To model the intention “Every FamousActor plays a MainCharacter” one might define equivalence between the class FamousActor and an Actor, who plays a MainCharacter. However, such a model additionally introduces a restriction that every Actor who plays a MainCharacter is a FamousActor, which is typically not intended.</example>
        <rdfs:comment>Logical over-restriction due to incorrect equivalence usage. A common student-made mistake is the confusion between the usage of equivalence and subClassOf restrictions which potentially leads to unintended over-restrictions.</rdfs:comment>
        <rdfs:label>OPR Mistake Type 3: Eqiuvalence Misuse</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#OPRMistakeType4LogicalMisunderstanding -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#OPRMistakeType4LogicalMisunderstanding">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#OPRMistake"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#OPRMistake"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasRelevantElement"/>
                        <owl:hasValue rdf:resource="http://www.semanticweb.org/user/vocabularies/owl2-opr#re_axioms"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasRelevantElement"/>
                        <owl:hasValue rdf:resource="http://www.semanticweb.org/user/vocabularies/owl2-opr#re_cardinality_restriction"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasRelevantElement"/>
                        <owl:hasValue rdf:resource="http://www.semanticweb.org/user/vocabularies/owl2-opr#re_exact_cardinality_restriction"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasRelevantElement"/>
                        <owl:hasValue rdf:resource="http://www.semanticweb.org/user/vocabularies/owl2-opr#re_existential_restriction"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasRelevantElement"/>
                        <owl:hasValue rdf:resource="http://www.semanticweb.org/user/vocabularies/owl2-opr#re_object_property"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasRelevantElement"/>
                        <owl:hasValue rdf:resource="http://www.semanticweb.org/user/vocabularies/owl2-opr#re_restriction"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasRelevantElement"/>
                        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">6</owl:qualifiedCardinality>
                        <owl:onClass rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#OPRModelingRelevantElement"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#OPRMistake"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasUnintendedOutcome"/>
                        <owl:hasValue rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#uo_not_intended_constraint"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasUnintendedOutcome"/>
                        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                        <owl:onClass rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#OPRMistakeUnintendedOutcome"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <example>To model the intention “A Professor may only work at one University” one might use a universal restriction rather than an exact cardinality of 1. However, modeling the requirement using the universal restriction would not restrict that a Professor only has one employment or that they must be employed at all.</example>
        <rdfs:comment>Logical misunderstanding of the used property restriction. Novice knowledge engineers might choose a restriction type not fitted for modeling their intention. This often leads to a mismatch between their ontology axiom and their intention. Examples of this mistake type are the incorrect usage of cardinality to express value constraints and interpreting the universal or existential restrictions as exact cardinality of 1.</rdfs:comment>
        <rdfs:label>OPR Mistake Type 4: Logical Misunderstanding of the Property Restriction</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#OPRMistakeType5TrivialSatisfaction -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#OPRMistakeType5TrivialSatisfaction">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#OPRMistake"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#OPRMistake"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasRelevantElement"/>
                        <owl:hasValue rdf:resource="http://www.semanticweb.org/user/vocabularies/owl2-opr#re_existential_restriction"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasRelevantElement"/>
                        <owl:hasValue rdf:resource="http://www.semanticweb.org/user/vocabularies/owl2-opr#re_individual"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasRelevantElement"/>
                        <owl:hasValue rdf:resource="http://www.semanticweb.org/user/vocabularies/owl2-opr#re_object_property"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasRelevantElement"/>
                        <owl:hasValue rdf:resource="http://www.semanticweb.org/user/vocabularies/owl2-opr#re_restriction"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasRelevantElement"/>
                        <owl:hasValue rdf:resource="http://www.semanticweb.org/user/vocabularies/owl2-opr#re_universal_restriction"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasRelevantElement"/>
                        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">5</owl:qualifiedCardinality>
                        <owl:onClass rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#OPRModelingRelevantElement"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#OPRMistake"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasUnintendedOutcome"/>
                        <owl:hasValue rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#uo_zero_case"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasUnintendedOutcome"/>
                        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                        <owl:onClass rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#OPRMistakeUnintendedOutcome"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <example>To model the intention “A Professor should work at a University” one might use a universal restriction. However, the model would not restrict that a Professor must be employed at all. Combining the universal restriction with an existential quantifier or minimum cardinality prevents such cases.</example>
        <rdfs:comment>Logical under-restriction, caused by the trivial satisfaction of the universal restriction. Novice knowledge engineers could incorrectly assume that the universal restriction implies the existential quantifier. This leads to valid instances with no property values at all when this was not intended.</rdfs:comment>
        <rdfs:label>OPR Mistake Type 5: Trivial Satisfaction of the Universal Restriction</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#OPRMistakeType6WrongClass -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#OPRMistakeType6WrongClass">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#OPRMistake"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#OPRMistake"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasRelevantElement"/>
                        <owl:hasValue rdf:resource="http://www.semanticweb.org/user/vocabularies/owl2-opr#re_class"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasRelevantElement"/>
                        <owl:hasValue rdf:resource="http://www.semanticweb.org/user/vocabularies/owl2-opr#re_individual"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasRelevantElement"/>
                        <owl:hasValue rdf:resource="http://www.semanticweb.org/user/vocabularies/owl2-opr#re_object_property"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasRelevantElement"/>
                        <owl:hasValue rdf:resource="http://www.semanticweb.org/user/vocabularies/owl2-opr#re_restriction"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasRelevantElement"/>
                        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">4</owl:qualifiedCardinality>
                        <owl:onClass rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#OPRModelingRelevantElement"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#OPRMistake"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasUnintendedOutcome"/>
                        <owl:hasValue rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#uo_over_restriction"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasUnintendedOutcome"/>
                        <owl:hasValue rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#uo_under_restriction"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasUnintendedOutcome"/>
                        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</owl:qualifiedCardinality>
                        <owl:onClass rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#OPRMistakeUnintendedOutcome"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <example>To model the intention “At least 3 Students attend a Course” one might add a property restriction to the class Student such as “Student attends min 3 Course”. However, this modeling would correspond to the definition that a Student must attend at least 3 Courses rather than the intended meaning.</example>
        <rdfs:comment>Property restriction placement at the wrong class. Sometimes novice knowledge engineers ignore the direction of an object property and thus place the restriction at the wrong class, which changes its logical interpretation and often leads to inconsistencies.</rdfs:comment>
        <rdfs:label>OPR Mistake Type 6: Wrong Class Restricted</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#OPRMistakeType7NonTyped -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#OPRMistakeType7NonTyped">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#OPRMistake"/>
        <rdfs:comment>In a single occurrence the student intention was superfluous and included broader definitions, which were only partly related to their modeled axiom. In another instance, an incorrect subClass definition was detected, in addition to a typed mistake.</rdfs:comment>
        <rdfs:label>OPR Mistake Type: Other</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#OPRMistakeUnintendedOutcome -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#OPRMistakeUnintendedOutcome">
        <rdfs:comment>The class comprises unintended consequences of the encountered mistake.</rdfs:comment>
        <rdfs:label>OPR Mistake Unintended Outcome</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#OPRModelingRelevantElement -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#OPRModelingRelevantElement">
        <rdfs:comment>The class comprises ontolgogical elements relevant to the encounmistake (such as the used property restriction, the domain of the property etc. )</rdfs:comment>
        <rdfs:label>OPR Modeling Relevant Element</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#PartiallyCompleteInferenceCapability -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#PartiallyCompleteInferenceCapability">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#InferenceCapability"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#InferenceCapability"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasScoringLevel"/>
                        <owl:hasValue rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#partial"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment>The explanation correctly but partially points out to (potential) unintended outcomes of the mistake.</rdfs:comment>
        <rdfs:label>Partly Complete Inference Capability</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#PartiallyCorrectModelingComprehension -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#PartiallyCorrectModelingComprehension">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#ModelingComprehension"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#ModelingComprehension"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasScoringLevel"/>
                        <owl:hasValue rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#partial"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment>The explanation contains a correct interpretation of the modeling for a subset of the relevant elements.</rdfs:comment>
        <rdfs:label>Partly Correct Modeling Comprehension</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#QualityDimension -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#QualityDimension">
        <rdfs:comment>describes a quality dimension against which the explanation can be evaluated</rdfs:comment>
        <rdfs:label>Quality Dimension</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#ScoringLevel -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#ScoringLevel">
        <rdfs:comment>The score level of each qaulity dimension</rdfs:comment>
        <rdfs:label>Scoring Level</rdfs:label>
    </owl:Class>
    


