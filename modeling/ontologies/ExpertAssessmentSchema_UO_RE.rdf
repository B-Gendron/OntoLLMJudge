<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.w3.org/2002/07/owl#"
     xml:base="http://www.w3.org/2002/07/owl"
     xmlns:opr="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">
    <Ontology rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema_uo_re"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#example -->

    <AnnotationProperty rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#example"/>
    


    <!-- http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#extractionDate -->

    <AnnotationProperty rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#extractionDate">
        <rdfs:label>extractionDate</rdfs:label>
    </AnnotationProperty>
    


    <!-- http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#extractionMethod -->

    <AnnotationProperty rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#extractionMethod">
        <rdfs:comment>Records whether a hasRelevantElement assertion was derived by direct text match (&apos;exact&apos;, &apos;fuzzy&apos;, &apos;syntactic&apos;) or by SKOS implication expansion (&apos;implied&apos;).</rdfs:comment>
        <rdfs:label>extractionMethod</rdfs:label>
    </AnnotationProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#containsDimension -->

    <ObjectProperty rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#containsDimension">
        <inverseOf rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#isPartOf"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#ExpertAssessmentSchema"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#QualityDimension"/>
    </ObjectProperty>
    


    <!-- http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#explainsMistake -->

    <ObjectProperty rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#explainsMistake">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#Explanation"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#OPRMistake"/>
    </ObjectProperty>
    


    <!-- http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasRelevantElement -->

    <ObjectProperty rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasRelevantElement">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#OPRMistake"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#OPRModelingRelevantElement"/>
        <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment>Links an OPRMistake type to the OWL 2 structural concepts (SKOS concepts) that are relevant elements for evaluating explanations of that mistake type. Derived automatically by the OPR keyword extraction pipeline.</rdfs:comment>
        <rdfs:label>hasRelevantElement</rdfs:label>
    </ObjectProperty>
    


    <!-- http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasScoringLevel -->

    <ObjectProperty rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasScoringLevel">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#QualityDimension"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#ScoringLevel"/>
    </ObjectProperty>
    


    <!-- http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasUnintendedOutcome -->

    <ObjectProperty rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasUnintendedOutcome">
        <inverseOf rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#isAnUnintendedOutcomeOf"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#OPRMistake"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#OPRMistakeUnintendedOutcome"/>
    </ObjectProperty>
    


    <!-- http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#isAnUnintendedOutcomeOf -->

    <ObjectProperty rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#isAnUnintendedOutcomeOf">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#OPRMistakeUnintendedOutcome"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#OPRMistake"/>
    </ObjectProperty>
    


    <!-- http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#isPartOf -->

    <ObjectProperty rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#isPartOf">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#QualityDimension"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#ExpertAssessmentSchema"/>
    </ObjectProperty>
    


    <!-- http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema_uo_re#hasQualityDimensionInstance -->

    <ObjectProperty rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema_uo_re#hasQualityDimensionInstance">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#Explanation"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#QualityDimension"/>
    </ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasText -->

    <DatatypeProperty rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasText">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#Explanation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#AbsenceOfInferenceCapability -->

    <Class rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#AbsenceOfInferenceCapability">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#InferenceCapability"/>
        <rdfs:subClassOf>
            <Class>
                <intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#InferenceCapability"/>
                    <Restriction>
                        <onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasScoringLevel"/>
                        <hasValue rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#void"/>
                    </Restriction>
                </intersectionOf>
            </Class>
        </rdfs:subClassOf>
        <rdfs:comment>The explanation does not point out to (potential) unintended outcomes of the mistake.</rdfs:comment>
    </Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#AbsenceOfMistakeCorrectionCompetence -->

    <Class rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#AbsenceOfMistakeCorrectionCompetence">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#MistakeCorrectionCompetence"/>
        <rdfs:subClassOf>
            <Class>
                <intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#MistakeCorrectionCompetence"/>
                    <Restriction>
                        <onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasScoringLevel"/>
                        <hasValue rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#void"/>
                    </Restriction>
                </intersectionOf>
            </Class>
        </rdfs:subClassOf>
        <rdfs:comment>The explanation does not include a modeling suggestion for fixing the mistake.</rdfs:comment>
    </Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#AbsenceOfModelingComprehension -->

    <Class rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#AbsenceOfModelingComprehension">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#ModelingComprehension"/>
        <rdfs:subClassOf>
            <Class>
                <intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#ModelingComprehension"/>
                    <Restriction>
                        <onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasScoringLevel"/>
                        <hasValue rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#void"/>
                    </Restriction>
                </intersectionOf>
            </Class>
        </rdfs:subClassOf>
        <rdfs:comment>The explanation does not contains an interpretation of the modeling.</rdfs:comment>
    </Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#AppropriateVocabularyUsage -->

    <Class rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#AppropriateVocabularyUsage">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#QualityDimension"/>
    </Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#CompleteInferenceCapability -->

    <Class rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#CompleteInferenceCapability">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#InferenceCapability"/>
        <rdfs:subClassOf>
            <Class>
                <intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#InferenceCapability"/>
                    <Restriction>
                        <onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasScoringLevel"/>
                        <hasValue rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#correct"/>
                    </Restriction>
                </intersectionOf>
            </Class>
        </rdfs:subClassOf>
        <rdfs:comment>The explanation correctly and completely points out to (potential) unintended outcomes of the mistake.</rdfs:comment>
    </Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#CorrectMistakeCorrectionCompetence -->

    <Class rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#CorrectMistakeCorrectionCompetence">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#MistakeCorrectionCompetence"/>
        <rdfs:subClassOf>
            <Class>
                <intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#MistakeCorrectionCompetence"/>
                    <Restriction>
                        <onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasScoringLevel"/>
                        <hasValue rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#correct"/>
                    </Restriction>
                </intersectionOf>
            </Class>
        </rdfs:subClassOf>
        <rdfs:comment>The explanation includes a correct modeling suggestion for fixing the mistake.</rdfs:comment>
    </Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#CorrectModelingComprehension -->

    <Class rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#CorrectModelingComprehension">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#ModelingComprehension"/>
        <rdfs:subClassOf>
            <Class>
                <intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#ModelingComprehension"/>
                    <Restriction>
                        <onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasScoringLevel"/>
                        <hasValue rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#correct"/>
                    </Restriction>
                </intersectionOf>
            </Class>
        </rdfs:subClassOf>
        <rdfs:comment>The explanation contains a correct interpretation of the modeling of all relevant elements.</rdfs:comment>
    </Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#CorrectVocabularyUsage -->

    <Class rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#CorrectVocabularyUsage">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#AppropriateVocabularyUsage"/>
        <rdfs:subClassOf>
            <Class>
                <intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#AppropriateVocabularyUsage"/>
                    <Restriction>
                        <onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasScoringLevel"/>
                        <hasValue rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#correct"/>
                    </Restriction>
                </intersectionOf>
            </Class>
        </rdfs:subClassOf>
        <rdfs:comment>The explanation demonstrates correct usage of domain-specific (ontology) terminology.</rdfs:comment>
    </Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#ExpertAssessmentSchema -->

    <Class rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#ExpertAssessmentSchema">
        <rdfs:comment>The Expert-Assessment Schema used to evaluate ontology axiom mistake explanations according to four key dimension: Modeling Comprehension, Inference Capability, Mistake Correction Competence and Appropriate Vocabulary Usage. For each dimension, the generated content matches one of the possible statements, and each statement gives a certain score.</rdfs:comment>
    </Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#Explanation -->

    <Class rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#Explanation"/>
    


    <!-- http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#IncorrectInferenceCapability -->

    <Class rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#IncorrectInferenceCapability">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#InferenceCapability"/>
        <rdfs:subClassOf>
            <Class>
                <intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#InferenceCapability"/>
                    <Restriction>
                        <onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasScoringLevel"/>
                        <hasValue rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#wrong"/>
                    </Restriction>
                </intersectionOf>
            </Class>
        </rdfs:subClassOf>
        <rdfs:comment>The explanation incorrectly points out to (potential) unintended outcomes of the mistake.</rdfs:comment>
    </Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#IncorrectMistakeCorrectionCompetence -->

    <Class rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#IncorrectMistakeCorrectionCompetence">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#MistakeCorrectionCompetence"/>
        <rdfs:subClassOf>
            <Class>
                <intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#MistakeCorrectionCompetence"/>
                    <Restriction>
                        <onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasScoringLevel"/>
                        <hasValue rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#wrong"/>
                    </Restriction>
                </intersectionOf>
            </Class>
        </rdfs:subClassOf>
        <rdfs:comment>The explanation includes an incorrect modeling suggestion for fixing the mistake.</rdfs:comment>
    </Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#IncorrectModelingComprehension -->

    <Class rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#IncorrectModelingComprehension">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#ModelingComprehension"/>
        <rdfs:subClassOf>
            <Class>
                <intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#ModelingComprehension"/>
                    <Restriction>
                        <onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasScoringLevel"/>
                        <hasValue rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#wrong"/>
                    </Restriction>
                </intersectionOf>
            </Class>
        </rdfs:subClassOf>
        <rdfs:comment>The explanation contains an incorrect interpretation of the modeling.</rdfs:comment>
    </Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#IncorrectVocabularyUsage -->

    <Class rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#IncorrectVocabularyUsage">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#AppropriateVocabularyUsage"/>
        <rdfs:subClassOf>
            <Class>
                <intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#AppropriateVocabularyUsage"/>
                    <Restriction>
                        <onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasScoringLevel"/>
                        <hasValue rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#wrong"/>
                    </Restriction>
                </intersectionOf>
            </Class>
        </rdfs:subClassOf>
        <rdfs:comment>The explanation demonstrates incorrect usage of domain-specific (ontology) terminology.</rdfs:comment>
    </Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#InferenceCapability -->

    <Class rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#InferenceCapability">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#QualityDimension"/>
    </Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#MistakeCorrectionCompetence -->

    <Class rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#MistakeCorrectionCompetence">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#QualityDimension"/>
    </Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#ModelingComprehension -->

    <Class rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#ModelingComprehension">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#QualityDimension"/>
    </Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#OPRMistake -->

    <Class rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#OPRMistake">
        <rdfs:comment>An Ontology Property Restriction (OPR) mistake is a modeling error made by a student when they write ontology property restrictions.</rdfs:comment>
    </Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#OPRMistakeType1_DomainRangeInconsistency -->

    <Class rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#OPRMistakeType1_DomainRangeInconsistency">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#OPRMistake"/>
        <rdfs:subClassOf>
            <Class>
                <intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#OPRMistake"/>
                    <Restriction>
                        <onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasRelevantElement"/>
                        <hasValue rdf:resource="http://www.semanticweb.org/user/vocabularies/owl2-opr#re_domain"/>
                    </Restriction>
                    <Restriction>
                        <onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasRelevantElement"/>
                        <hasValue rdf:resource="http://www.semanticweb.org/user/vocabularies/owl2-opr#re_individual"/>
                    </Restriction>
                    <Restriction>
                        <onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasRelevantElement"/>
                        <hasValue rdf:resource="http://www.semanticweb.org/user/vocabularies/owl2-opr#re_object_property"/>
                    </Restriction>
                    <Restriction>
                        <onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasRelevantElement"/>
                        <hasValue rdf:resource="http://www.semanticweb.org/user/vocabularies/owl2-opr#re_range"/>
                    </Restriction>
                    <Restriction>
                        <onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasRelevantElement"/>
                        <hasValue rdf:resource="http://www.semanticweb.org/user/vocabularies/owl2-opr#re_restriction"/>
                    </Restriction>
                    <Restriction>
                        <onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasUnintendedOutcome"/>
                        <hasValue rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#uo_inconsistency"/>
                    </Restriction>
                    <Restriction>
                        <onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasRelevantElement"/>
                        <qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">5</qualifiedCardinality>
                        <onClass rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#OPRModelingRelevantElement"/>
                    </Restriction>
                    <Restriction>
                        <onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasUnintendedOutcome"/>
                        <qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</qualifiedCardinality>
                        <onClass rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#OPRMistakeUnintendedOutcome"/>
                    </Restriction>
                </intersectionOf>
            </Class>
        </rdfs:subClassOf>
        <opr:example>Assuming the object property takesPictureOf is defined with a domain Photographer and range Wedding. To model the intention “A Photographer takes pictures of at least 10 Guests” one might add a restriction “Photographer takesPictureOf min 10 Guest”. However, such a restriction could lead to an inconsistency or wrong inferences such as Guest being a sucClassOf Wedding.</opr:example>
        <rdfs:comment>Mismatch between the domain and range of an object property and the property restriction definition. Students often overlook the domain and range of object properties and thus define restrictions which do not comply with existing ontology definition.</rdfs:comment>
    </Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#OPRMistakeType2_DomainRangeMisplacement -->

    <Class rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#OPRMistakeType2_DomainRangeMisplacement">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#OPRMistake"/>
        <rdfs:subClassOf>
            <Class>
                <intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#OPRMistake"/>
                    <Restriction>
                        <onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasRelevantElement"/>
                        <hasValue rdf:resource="http://www.semanticweb.org/user/vocabularies/owl2-opr#re_individual"/>
                    </Restriction>
                    <Restriction>
                        <onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasRelevantElement"/>
                        <hasValue rdf:resource="http://www.semanticweb.org/user/vocabularies/owl2-opr#re_object_property"/>
                    </Restriction>
                    <Restriction>
                        <onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasRelevantElement"/>
                        <hasValue rdf:resource="http://www.semanticweb.org/user/vocabularies/owl2-opr#re_range"/>
                    </Restriction>
                    <Restriction>
                        <onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasRelevantElement"/>
                        <hasValue rdf:resource="http://www.semanticweb.org/user/vocabularies/owl2-opr#re_restriction"/>
                    </Restriction>
                    <Restriction>
                        <onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasUnintendedOutcome"/>
                        <hasValue rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#uo_inconsistency"/>
                    </Restriction>
                    <Restriction>
                        <onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasRelevantElement"/>
                        <qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">4</qualifiedCardinality>
                        <onClass rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#OPRModelingRelevantElement"/>
                    </Restriction>
                    <Restriction>
                        <onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasUnintendedOutcome"/>
                        <qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</qualifiedCardinality>
                        <onClass rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#OPRMistakeUnintendedOutcome"/>
                    </Restriction>
                </intersectionOf>
            </Class>
        </rdfs:subClassOf>
        <opr:example>To model the intention “A Student attends at least 3 Courses” one might add a property restriction as the range of the object property attends such as “attends min 3 Course”. However, this placement would result in the definition that the range of attends must be a Thing that attends 3 Courses rather than the intended meaning.</opr:example>
        <rdfs:comment>Incorrect property restriction placement in the property range. Often novice knowledge engineers define the restriction in the range of the object property rather than at the class-level, which changes its logical interpretation and often leads to inconsistencies.</rdfs:comment>
    </Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#OPRMistakeType3_EquivalenceMisuse -->

    <Class rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#OPRMistakeType3_EquivalenceMisuse">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#OPRMistake"/>
        <rdfs:subClassOf>
            <Class>
                <intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#OPRMistake"/>
                    <Restriction>
                        <onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasRelevantElement"/>
                        <hasValue rdf:resource="http://www.semanticweb.org/user/vocabularies/owl2-opr#re_restriction"/>
                    </Restriction>
                    <Restriction>
                        <onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasRelevantElement"/>
                        <hasValue rdf:resource="http://www.semanticweb.org/user/vocabularies/owl2-opr#re_sub_class_of_axiom"/>
                    </Restriction>
                    <Restriction>
                        <onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasRelevantElement"/>
                        <hasValue rdf:resource="http://www.semanticweb.org/user/vocabularies/owl2-opr#re_subclass"/>
                    </Restriction>
                    <Restriction>
                        <onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasRelevantElement"/>
                        <qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">3</qualifiedCardinality>
                        <onClass rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#OPRModelingRelevantElement"/>
                    </Restriction>
                </intersectionOf>
            </Class>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <Class>
                <intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#OPRMistake"/>
                    <Restriction>
                        <onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasUnintendedOutcome"/>
                        <hasValue rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#uo_over_restriction"/>
                    </Restriction>
                    <Restriction>
                        <onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasUnintendedOutcome"/>
                        <hasValue rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#uo_wrong_class_restricted"/>
                    </Restriction>
                    <Restriction>
                        <onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasUnintendedOutcome"/>
                        <qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</qualifiedCardinality>
                        <onClass rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#OPRMistakeUnintendedOutcome"/>
                    </Restriction>
                </intersectionOf>
            </Class>
        </rdfs:subClassOf>
        <opr:example>To model the intention “Every FamousActor plays a MainCharacter” one might define equivalence between the class FamousActor and an Actor, who plays a MainCharacter. However, such a model additionally introduces a restriction that every Actor who plays a MainCharacter is a FamousActor, which is typically not intended.</opr:example>
        <rdfs:comment>Logical over-restriction due to incorrect equivalence usage. A common student-made mistake is the confusion between the usage of equivalence and subClassOf restrictions which potentially leads to unintended over-restrictions.</rdfs:comment>
    </Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#OPRMistakeType4_LogicalMisunderstanding -->

    <Class rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#OPRMistakeType4_LogicalMisunderstanding">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#OPRMistake"/>
        <rdfs:subClassOf>
            <Class>
                <intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#OPRMistake"/>
                    <Restriction>
                        <onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasRelevantElement"/>
                        <hasValue rdf:resource="http://www.semanticweb.org/user/vocabularies/owl2-opr#re_axioms"/>
                    </Restriction>
                    <Restriction>
                        <onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasRelevantElement"/>
                        <hasValue rdf:resource="http://www.semanticweb.org/user/vocabularies/owl2-opr#re_cardinality_restriction"/>
                    </Restriction>
                    <Restriction>
                        <onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasRelevantElement"/>
                        <hasValue rdf:resource="http://www.semanticweb.org/user/vocabularies/owl2-opr#re_exact_cardinality_restriction"/>
                    </Restriction>
                    <Restriction>
                        <onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasRelevantElement"/>
                        <hasValue rdf:resource="http://www.semanticweb.org/user/vocabularies/owl2-opr#re_existential_restriction"/>
                    </Restriction>
                    <Restriction>
                        <onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasRelevantElement"/>
                        <hasValue rdf:resource="http://www.semanticweb.org/user/vocabularies/owl2-opr#re_object_property"/>
                    </Restriction>
                    <Restriction>
                        <onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasRelevantElement"/>
                        <hasValue rdf:resource="http://www.semanticweb.org/user/vocabularies/owl2-opr#re_restriction"/>
                    </Restriction>
                    <Restriction>
                        <onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasRelevantElement"/>
                        <qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">6</qualifiedCardinality>
                        <onClass rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#OPRModelingRelevantElement"/>
                    </Restriction>
                </intersectionOf>
            </Class>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <Class>
                <intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#OPRMistake"/>
                    <Restriction>
                        <onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasUnintendedOutcome"/>
                        <hasValue rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#uo_not_intended_constraint"/>
                    </Restriction>
                    <Restriction>
                        <onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasUnintendedOutcome"/>
                        <qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</qualifiedCardinality>
                        <onClass rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#OPRMistakeUnintendedOutcome"/>
                    </Restriction>
                </intersectionOf>
            </Class>
        </rdfs:subClassOf>
        <opr:example>To model the intention “A Professor may only work at one University” one might use a universal restriction rather than an exact cardinality of 1. However, modeling the requirement using the universal restriction would not restrict that a Professor only has one employment or that they must be employed at all.</opr:example>
        <rdfs:comment>Logical misunderstanding of the used property restriction. Novice knowledge engineers might choose a restriction type not fitted for modeling their intention. This often leads to a mismatch between their ontology axiom and their intention. Examples of this mistake type are the incorrect usage of cardinality to express value constraints and interpreting the universal or existential restrictions as exact cardinality of 1.</rdfs:comment>
    </Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#OPRMistakeType5_TrivialSatisfaction -->

    <Class rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#OPRMistakeType5_TrivialSatisfaction">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#OPRMistake"/>
        <rdfs:subClassOf>
            <Class>
                <intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#OPRMistake"/>
                    <Restriction>
                        <onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasRelevantElement"/>
                        <hasValue rdf:resource="http://www.semanticweb.org/user/vocabularies/owl2-opr#re_existential_restriction"/>
                    </Restriction>
                    <Restriction>
                        <onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasRelevantElement"/>
                        <hasValue rdf:resource="http://www.semanticweb.org/user/vocabularies/owl2-opr#re_individual"/>
                    </Restriction>
                    <Restriction>
                        <onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasRelevantElement"/>
                        <hasValue rdf:resource="http://www.semanticweb.org/user/vocabularies/owl2-opr#re_object_property"/>
                    </Restriction>
                    <Restriction>
                        <onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasRelevantElement"/>
                        <hasValue rdf:resource="http://www.semanticweb.org/user/vocabularies/owl2-opr#re_restriction"/>
                    </Restriction>
                    <Restriction>
                        <onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasRelevantElement"/>
                        <hasValue rdf:resource="http://www.semanticweb.org/user/vocabularies/owl2-opr#re_universal_restriction"/>
                    </Restriction>
                    <Restriction>
                        <onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasRelevantElement"/>
                        <qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">5</qualifiedCardinality>
                        <onClass rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#OPRModelingRelevantElement"/>
                    </Restriction>
                </intersectionOf>
            </Class>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <Class>
                <intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#OPRMistake"/>
                    <Restriction>
                        <onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasUnintendedOutcome"/>
                        <hasValue rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#uo_zero_case"/>
                    </Restriction>
                    <Restriction>
                        <onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasUnintendedOutcome"/>
                        <qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</qualifiedCardinality>
                        <onClass rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#OPRMistakeUnintendedOutcome"/>
                    </Restriction>
                </intersectionOf>
            </Class>
        </rdfs:subClassOf>
        <opr:example>To model the intention “A Professor should work at a University” one might use a universal restriction. However, the model would not restrict that a Professor must be employed at all. Combining the universal restriction with an existential quantifier or minimum cardinality prevents such cases.</opr:example>
        <rdfs:comment>Logical under-restriction, caused by the trivial satisfaction of the universal restriction. Novice knowledge engineers could incorrectly assume that the universal restriction implies the existential quantifier. This leads to valid instances with no property values at all when this was not intended.</rdfs:comment>
    </Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#OPRMistakeType6_WrongClass -->

    <Class rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#OPRMistakeType6_WrongClass">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#OPRMistake"/>
        <rdfs:subClassOf>
            <Class>
                <intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#OPRMistake"/>
                    <Restriction>
                        <onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasRelevantElement"/>
                        <hasValue rdf:resource="http://www.semanticweb.org/user/vocabularies/owl2-opr#re_class"/>
                    </Restriction>
                    <Restriction>
                        <onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasRelevantElement"/>
                        <hasValue rdf:resource="http://www.semanticweb.org/user/vocabularies/owl2-opr#re_individual"/>
                    </Restriction>
                    <Restriction>
                        <onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasRelevantElement"/>
                        <hasValue rdf:resource="http://www.semanticweb.org/user/vocabularies/owl2-opr#re_object_property"/>
                    </Restriction>
                    <Restriction>
                        <onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasRelevantElement"/>
                        <hasValue rdf:resource="http://www.semanticweb.org/user/vocabularies/owl2-opr#re_restriction"/>
                    </Restriction>
                    <Restriction>
                        <onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasRelevantElement"/>
                        <qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">4</qualifiedCardinality>
                        <onClass rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#OPRModelingRelevantElement"/>
                    </Restriction>
                </intersectionOf>
            </Class>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <Class>
                <intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#OPRMistake"/>
                    <Restriction>
                        <onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasUnintendedOutcome"/>
                        <hasValue rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#uo_over_restriction"/>
                    </Restriction>
                    <Restriction>
                        <onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasUnintendedOutcome"/>
                        <hasValue rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#uo_under_restriction"/>
                    </Restriction>
                    <Restriction>
                        <onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasUnintendedOutcome"/>
                        <qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</qualifiedCardinality>
                        <onClass rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#OPRMistakeUnintendedOutcome"/>
                    </Restriction>
                </intersectionOf>
            </Class>
        </rdfs:subClassOf>
        <opr:example>To model the intention “At least 3 Students attend a Course” one might add a property restriction to the class Student such as “Student attends min 3 Course”. However, this modeling would correspond to the definition that a Student must attend at least 3 Courses rather than the intended meaning.</opr:example>
        <rdfs:comment>Property restriction placement at the wrong class. Sometimes novice knowledge engineers ignore the direction of an object property and thus place the restriction at the wrong class, which changes its logical interpretation and often leads to inconsistencies.</rdfs:comment>
    </Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#OPRMistakeTypeOther -->

    <Class rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#OPRMistakeTypeOther">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#OPRMistake"/>
        <rdfs:comment>In a single occurrence the student intention was superfluous and included broader definitions, which were only partly related to their modeled axiom. In another instance, an incorrect subClass definition was detected, in addition to a typed mistake.</rdfs:comment>
    </Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#OPRMistakeUnintendedOutcome -->

    <Class rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#OPRMistakeUnintendedOutcome"/>
    


    <!-- http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#OPRModelingRelevantElement -->

    <Class rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#OPRModelingRelevantElement"/>
    


    <!-- http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#PartiallyCompleteInferenceCapability -->

    <Class rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#PartiallyCompleteInferenceCapability">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#InferenceCapability"/>
        <rdfs:subClassOf>
            <Class>
                <intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#InferenceCapability"/>
                    <Restriction>
                        <onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#hasScoringLevel"/>
                        <hasValue rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/expertassessmentschema#partial"/>
                    </Restriction>
                </intersectionOf>
            </Class>
        </rdfs:subClassOf>
        <rdfs:comment>The explanation correctly but partially points out to (potential) unintended outcomes of the mistake.</rdfs:comment>
    </Class>
    


